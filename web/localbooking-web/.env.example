# Production API Backend URL (Set this in Vercel Environment Variables dashboard)
VITE_API_URL=https://localbooking-api.onrender.com/api

# Optional: Direct Supabase Client Integration (if using Supabase Auth / JS SDK)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Local development only: use mock data when the API is unreachable.
# Ignored in production builds (npm run build). Never set this in Vercel.
VITE_USE_MOCKS=false
